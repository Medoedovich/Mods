ButtonWidgetClass CatalogItemRow {
 Name "CatalogItemRow"
 position 0 0
 size 308 24
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 clipchildren 1
 style IOT_Button
 {
  PanelWidgetClass CatalogItemBackground {
   Name "CatalogItemBackground"
   position 0 0
   size 1 1
   ignorepointer 1
   color 0 0 0 0
   style rover_sim_colorable
  }
  TextWidgetClass CatalogItemLabel {
   Name "CatalogItemLabel"
   position 4 2
   size 300 20
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   ignorepointer 1
   font "gui/fonts/Metron14"
   "exact text" 1
   "text color" 1 1 1 1
  }
  PanelWidgetClass CatalogItemAccent {
   Name "CatalogItemAccent"
   position 0 0
   size 2 1
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 0
   visible 0
   ignorepointer 1
   color 0.88 0.82 0.70 1
   style rover_sim_colorable
  }
 }
}
